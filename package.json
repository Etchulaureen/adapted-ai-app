{
  "name": "prism",
  "version": "0.1.0",
  "private": true,
  "description": "Prism - an accessibility layer that splits educational content into Readable, Focused, and Visual presentations while verifying fidelity to the source.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@google/genai": "^1.0.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  }
}

# "mock" (default) needs no credentials at all - deterministic, no invented facts, good for
# building/demoing the whole flow. Set to "anthropic" or "gemini" to use a real model.
AI_PROVIDER=mock

# Only read when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only read when AI_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - defaults to 4318
PORT=4318
